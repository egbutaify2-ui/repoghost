# Required to enable AI-generated analysis. Create a key online at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Pin inference to Gemma 4 open weights; RepoGhost does not silently switch to another model.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Recommended on hosted runtimes to avoid shared-IP unauthenticated rate limits.
GITHUB_TOKEN=
# Set this to the deployed public app URL if desired for inference-provider attribution.
APP_URL=https://your-repoghost-domain.example
# Hosting platform supplies PORT; set only for local cloud preview if needed.
PORT=3000
